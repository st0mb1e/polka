# npm run setup создаёт .env и генерирует все секреты и пароль.
AUTH_PROVIDER=google
# OAuth client типа Web application: https://console.cloud.google.com/auth/clients
# Redirect URI: http://127.0.0.1:3000/auth/callback
# Разрешения: openid profile email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Адрес прослушивания: 127.0.0.1 — локально, 0.0.0.0 — все интерфейсы.
HOST=127.0.0.1
APP_PORT=3000
# Публичный адрес сайта. Пустое значение: http://HOST:APP_PORT.
# Google разрешает HTTP только на localhost; для других хостов нужен HTTPS-домен.
# Для ВМ можно указать http://127.0.0.1:3000 и открыть сайт через SSH-проброс.
APP_URL=
AUTH_PORT=3001
# Адрес локального OAuth-провайдера; по умолчанию http://HOST:AUTH_PORT.
AUTH_URL=
CLIENT_ID=lab-web-app
CLIENT_SECRET=
SESSION_SECRET=
AUTH_COOKIE_SECRET=
# Остальные параметры используются только при AUTH_PROVIDER=local.
DEMO_USERNAME=student
DEMO_PASSWORD=
DEMO_NAME="Студент"
DEMO_EMAIL=student@example.local
