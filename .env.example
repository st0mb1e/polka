# npm run setup создаёт .env и генерирует все секреты и пароль.
AUTH_PROVIDER=yandex
# Из зарегистрированного приложения: https://oauth.yandex.ru/
# Redirect URI: http://127.0.0.1:3000/auth/callback
# Разрешения: login:info login:email
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
APP_PORT=3000
AUTH_PORT=3001
CLIENT_ID=lab-web-app
CLIENT_SECRET=
SESSION_SECRET=
AUTH_COOKIE_SECRET=
# Остальные параметры используются только при AUTH_PROVIDER=local.
DEMO_USERNAME=student
DEMO_PASSWORD=
DEMO_NAME="Студент"
DEMO_EMAIL=student@example.local
